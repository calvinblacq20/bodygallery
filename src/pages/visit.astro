---
import visitBand from '../assets/photos/statement.jpg';
import HoursTable from '../components/HoursTable.astro';
import Icon from '../components/Icon.astro';
import LetterTitle from '../components/LetterTitle.astro';
import Photo from '../components/Photo.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Base from '../layouts/Base.astro';
import { generalBookingUrl } from '../lib/booking';
import { formatLocalPhone, telHref } from '../lib/format';
import { loadSite } from '../lib/site';

const { settings } = await loadSite();
const { geo } = settings;
const mapEmbed = `https://www.google.com/maps?q=${geo.lat},${geo.lng}&z=16&output=embed`;
const today = new Date().toISOString().slice(0, 10);
const upcomingClosures = settings.closures.filter((c) => c.date >= today);
---

<Base
  title="Visit · Body Gallery Kasoa"
  description="Find Body Gallery just off Nyanyano Road at Monaco Junction, Kasoa. Directions, map, opening hours and phone numbers."
  settings={settings}
>
  <section class="wrap pt-32 md:pt-40">
    <LetterTitle text="Visit" />
    <p class="mt-4 max-w-[40ch] text-sm" data-reveal>
      Just off Nyanyano Road at Monaco Junction, Kasoa. Here's how to find us.
    </p>
  </section>

  <div class="wrap mt-12 md:mt-16">
    <Photo
      src={visitBand}
      alt="Woman with glowing skin and her eyes closed"
      position="50% 40%"
      class="aspect-[4/3] md:aspect-[16/6]"
      widths={[800, 1400, 2000]}
      eager
      data-reveal="fade"
    />
  </div>

  <section class="wrap mt-20 grid gap-12 md:mt-28 md:grid-cols-2 md:gap-16">
    <div class="space-y-8" data-reveal>
      <div>
        <h2 class="t-label-sm">{settings.businessName}</h2>
        <address class="mt-3 text-[1.05rem] not-italic">
          {settings.address.street}
          <br />
          {settings.address.locality}, {settings.address.region}
          <br />
          <span class="text-muted">Plus Code: {settings.plusCode}</span>
        </address>
      </div>

      <div>
        <h3 class="font-medium">Getting here</h3>
        <ul class="mt-3 space-y-2">
          {settings.directions.map((step) => (
            <li>{step}</li>
          ))}
        </ul>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={settings.socials.googleMaps}
          class="btn btn-solid"
          rel="noopener"
          data-event="directions_click"
        >
          <Icon name="pin" size={18} /> Open in Google Maps
        </a>
        {settings.phones.map((p) => (
          <a
            href={telHref(p.e164)}
            class="btn border border-ink/30 hover:border-ink"
            data-event="call_click"
          >
            <Icon name="phone" size={18} /> {formatLocalPhone(p.e164)}
          </a>
        ))}
      </div>
    </div>

    <div data-reveal style="--reveal-delay:0.1s">
      <p
        class="mb-4 inline-block rounded-full bg-paper px-3 py-1 text-sm"
        data-open-status
        data-hours={JSON.stringify(settings.hours)}
        data-closures={JSON.stringify(settings.closures)}
        data-tz={settings.timezone}
      >
        Opening hours
      </p>
      <HoursTable hours={settings.hours} />
      {upcomingClosures.length > 0 && (
        <ul class="mt-4 space-y-1 text-sm">
          {upcomingClosures.map((c) => (
            <li>
              <strong class="font-medium">{c.date}:</strong> {c.note}
            </li>
          ))}
        </ul>
      )}
      <p class="mt-4 text-sm text-muted">{settings.bookingPolicy}</p>
    </div>
  </section>

  <section class="wrap mt-16 md:mt-24">
    <div
      class="relative grid aspect-[4/3] place-items-center overflow-hidden rounded-lg bg-paper md:aspect-[16/7]"
      data-map={mapEmbed}
    >
      <div class="flex flex-col items-center gap-3 p-6 text-center">
        <Icon name="pin" size={28} />
        <p class="max-w-[36ch] text-muted">
          The map loads only when you ask for it, to save your data.
        </p>
        <button type="button" class="btn btn-solid" data-map-load hidden>
          Show map
        </button>
        <a href={settings.socials.googleMaps} rel="noopener" class="link-underline nojs-only">
          Open the map in Google Maps
        </a>
      </div>
    </div>
  </section>

  <section class="mt-24 bg-paper py-20 md:mt-32 md:py-28">
    <SectionTitle label="Make an" accent="appointment" />
    <p class="wrap mt-6 max-w-[46ch] text-center text-muted" data-reveal>
      Pick a treatment, a day and a time, and we'll confirm on WhatsApp. Advanced treatments are by
      appointment only.
    </p>
    <div class="wrap mt-8 flex flex-wrap justify-center gap-3" data-reveal>
      <a href="/book" class="btn btn-solid">
        Book a visit <span aria-hidden="true">→</span>
      </a>
      <a
        href={generalBookingUrl(settings.whatsappE164)}
        class="btn border border-ink/30 hover:border-ink"
        data-event="book_whatsapp"
        data-event-label="visit"
      >
        Message us on WhatsApp
      </a>
    </div>
  </section>
</Base>

<script>
  // Load the Google map only on request: it's heavy on mobile data.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    const button = box.querySelector<HTMLButtonElement>('[data-map-load]');
    if (!button || !box.dataset.map) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.map ?? '';
      frame.title = 'Map showing where Body Gallery is';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(frame);
    });
  });
</script>
