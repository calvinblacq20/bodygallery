---
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['accordion', className]}>
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p class="answer">{item.a}</p>
    </details>
  ))}
</div>
