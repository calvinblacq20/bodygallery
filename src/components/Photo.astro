---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata | undefined;
  /** Empty string marks the image as decorative. */
  alt: string;
  /** Background colouring while the photo loads, or in place of a missing photo. */
  tone?: 'deep' | 'warm' | 'blush' | 'cream';
  /** Art-direction note shown only when no photo is supplied, so the shoot list writes itself. */
  note?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
  /** Generated widths; keep them close to the largest size the slot is shown at. */
  widths?: number[];
  /** CSS object-position, to keep the subject in frame when the slot crops the photo. */
  position?: string | undefined;
  inner?: string;
  style?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  src,
  alt,
  tone = 'warm',
  note,
  class: className = '',
  eager = false,
  sizes = '100vw',
  widths = [480, 800, 1200],
  position,
  inner = '',
  style,
  ...data
} = Astro.props;
---

<div class:list={['photo-slot', className]} data-tone={tone} style={style} {...data}>
  {src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class={inner}
      style={position ? `object-position:${position}` : undefined}
    />
  ) : (
    <div
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      class:list={['absolute inset-0', inner]}
    >
      {note && <span class="photo-note">Photo: {note}</span>}
    </div>
  )}
  <slot />
</div>
