---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata | undefined;
  /** Empty string marks the image as decorative. */
  alt: string;
  /** Placeholder colouring until the real photo is supplied (PRD M0 shoot). */
  tone?: 'deep' | 'warm' | 'blush' | 'cream';
  /** Art-direction note shown on the placeholder so the shoot list writes itself. */
  note?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
  inner?: string;
  style?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  src,
  alt,
  tone = 'warm',
  note,
  class: className = '',
  eager = false,
  sizes = '100vw',
  inner = '',
  style,
  ...data
} = Astro.props;
---

<div class:list={['photo-slot', className]} data-tone={tone} style={style} {...data}>
  {src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1800]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class={inner}
    />
  ) : (
    <div
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      class:list={['absolute inset-0', inner]}
    >
      {note && <span class="photo-note">Photo: {note}</span>}
    </div>
  )}
  <slot />
</div>
