---
import Logo from './Logo.astro';

interface Props {
  /** "light" = white text over a hero photo; "dark" = ink text on a light page. */
  tone?: 'light' | 'dark';
}

const { tone = 'dark' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '') || '/';
const isCurrent = (href: string) =>
  href === path || (href === '/services' && path.startsWith('/services/'));
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/#packages', label: 'Packages' },
  { href: '/about', label: 'About' },
  { href: '/visit', label: 'Visit' },
];
---

<header
  class:list={['absolute inset-x-0 top-0 z-30', tone === 'light' ? 'text-white' : 'text-ink']}
>
  <div class="wrap flex h-20 items-center justify-between md:h-28">
    <div class="flex items-center gap-[clamp(2rem,9vw,11rem)]">
      <a href="/" class="block shrink-0" aria-label="Body Gallery home">
        <Logo
          tone={tone === 'light' ? 'light' : 'dark'}
          width={210}
          class="h-9 w-auto md:h-12"
          eager
        />
      </a>
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex gap-6 text-[1.05rem]">
          {links.map(({ href, label }) => (
            <li>
              <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <a
      href="/book"
      class:list={['btn hidden md:inline-flex', tone === 'light' ? 'btn-ghost-light' : 'btn-solid']}
    >
      Book now <span aria-hidden="true">→</span>
    </a>

    <button
      type="button"
      class="grid h-11 w-11 place-items-center md:hidden"
      popovertarget="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="22" height="12" viewBox="0 0 22 12" aria-hidden="true">
        <path d="M0 1h22M0 11h22" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu" popover class="mobile-menu text-ink">
  <div class="wrap flex h-20 items-center justify-between">
    <a href="/" class="block shrink-0" aria-label="Body Gallery home">
      <Logo width={170} class="h-9 w-auto" />
    </a>
    <button
      type="button"
      class="grid h-11 w-11 place-items-center"
      popovertarget="mobile-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="wrap pt-6">
    <ul class="flex flex-col gap-2 text-[1.35rem]">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block py-2"
            data-close-menu
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/book" class="btn btn-solid mt-8">
      Book now <span aria-hidden="true">→</span>
    </a>
  </nav>
</div>

<style>
  .nav-link {
    position: relative;
    padding-block: 0.25rem;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .mobile-menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    background: var(--color-snow);
    opacity: 0;
    transition:
      opacity 0.35s ease,
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
