---
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
// Preloaded so the giant wordmark doesn't reflow when the web font arrives.
import headingFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuickActions from '../components/QuickActions.astro';
import type { Settings } from '../content/schemas';
import { generalBookingUrl } from '../lib/booking';
import { MOTION_SCRIPT } from '../lib/inline-scripts';
import { PRELAUNCH } from '../lib/site';

interface Props {
  title: string;
  description: string;
  settings: Settings;
  headerTone?: 'light' | 'dark';
  /** Book button in the on-screen Book / Call / WhatsApp actions; off where the page is the booking flow. */
  bookAction?: boolean;
  /** Keep this page out of search engines even after launch (tools such as /motion-check). */
  noindex?: boolean;
}

const {
  title,
  description,
  settings,
  headerTone = 'dark',
  bookAction = true,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bookUrl = generalBookingUrl(settings.whatsappE164);
---

<!doctype html>
<html lang="en-GH" data-motion="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={MOTION_SCRIPT} />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(PRELAUNCH || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fcfcfb" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GH" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded bg-ink px-4 py-2 text-snow focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} bookUrl={bookUrl} />

    <QuickActions settings={settings} book={bookAction} />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  @media (max-width: 767px) {
    :global(body:has(.quick-actions)) {
      /* Full-height sections subtract this so the action bar never covers their last line. */
      --action-bar-space: 80px;
      padding-bottom: var(--action-bar-space);
    }
  }
</style>
